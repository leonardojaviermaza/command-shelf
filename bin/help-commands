#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# help-commands: Lists your own commands, grouped, and runs the one you pick.
# Finds the executables in ~/.local/bin and /usr/local/bin with a line "# help-commands: <description>" among their first
# five lines. To add a command, give it that line and install it in one of those folders.
#
# The group comes, in this order, from:
#   1. a line "# help-commands-group: <group>" in the command itself;
#   2. ~/.config/help-commands/groups, one "<command>=<group>" per line (for the ones you cannot edit),
#      and "*=<group>" for the default;
#   3. otherwise, "General".
#
# A command that needs parameters declares them, one line each and in order, among its first 30 lines:
#   # help-commands-arg: <name> help         required: it is asked again while it is empty
#   # help-commands-arg: [name] help         optional: left empty, it is not passed
#   # help-commands-arg: [name=30] help      starts with that value; "name=a|b" proposes a and b, starting with a
# Each answer reaches the command as one argument, spaces and all. A command without them asks for a free line of arguments.
#
# Usage:
#   help-commands          a menu to pick a command and run it
#   help-commands --list   only the list (also when the output is not a terminal)
#   help-commands --add    asks for a new command (name, group, what it does, what it runs) and writes it in ~/.local/bin
#
# Part of Command Shelf (https://github.com/leonardojaviermaza/command-shelf): its GNOME extension shows the same list in the top bar.
set -uo pipefail

self=$(basename "$0")
groups_file="${XDG_CONFIG_HOME:-$HOME/.config}/help-commands/groups"

# The few texts it says, in Spanish when the system is.
if [[ "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" == es* ]]; then
  t_none="No hay comandos propios instalados."
  t_title="Comandos propios"
  t_menu="Elegí un comando (flechas + Enter, Esc para salir):"
  t_number="Número del comando (Enter para salir): "
  t_invalid="Opción inválida:"
  t_args="Argumentos para %s (Enter = ninguno): "
  t_optional="opcional"
  t_missing="Hace falta %s (Ctrl-D para salir)."
  t_add_item="＋ Agregar un comando"
  t_name="Nombre (letras, números, . - _): "
  t_bad_name="Ese nombre no sirve: sólo letras, números, puntos, guiones y guiones bajos, y empieza con letra o número."
  t_taken="Ya hay un comando que se llama %s."
  t_groups="Grupos que ya existen:"
  t_group="Grupo (número, o un nombre nuevo): "
  t_new_group="Grupo nuevo: «%s». ¿Lo creo? [S/n] "
  t_desc="Qué hace: "
  t_cmd="Qué ejecuta: "
  t_empty="No puede quedar vacío."
  t_added="Listo: %s quedó en %s, en el grupo %s."
  default_group="General"
else
  t_none="No commands of your own installed yet."
  t_title="Your commands"
  t_menu="Pick a command (arrows + Enter, Esc to leave):"
  t_number="Command number (Enter to leave): "
  t_invalid="Invalid option:"
  t_args="Arguments for %s (Enter = none): "
  t_optional="optional"
  t_missing="%s is needed (Ctrl-D to leave)."
  t_add_item="＋ Add a command"
  t_name="Name (letters, digits, . - _): "
  t_bad_name="That name will not do: only letters, digits, dots, dashes and underscores, starting with a letter or digit."
  t_taken="There is already a command called %s."
  t_groups="Groups that already exist:"
  t_group="Group (a number, or a new name): "
  t_new_group="New group: \"%s\". Create it? [Y/n] "
  t_desc="What it does: "
  t_cmd="What it runs: "
  t_empty="It cannot be empty."
  t_added="Done: %s is in %s, under %s."
  default_group="General"
fi

declare -A mapped=()
if [[ -r "$groups_file" ]]; then
  while IFS='=' read -r key value; do
    key=$(sed 's/^ *//; s/ *$//' <<<"$key")
    [[ -n "$key" && "$key" != \#* ]] || continue
    mapped[$key]=$(sed 's/^ *//; s/ *$//' <<<"$value")
  done <"$groups_file"
fi
[[ -n "${mapped['*']:-}" ]] && default_group=${mapped['*']}

names=()
descs=()
paths=()
groups=()
specs=()
declare -A seen=()

# The parameter lines of a command travel joined by this byte, which no header has.
sep=$'\x1f'

while IFS=$'\t' read -r group name desc path spec; do
  groups+=("$group")
  names+=("$name")
  descs+=("$desc")
  paths+=("$path")
  specs+=("$spec")
done < <(
  for dir in "$HOME/.local/bin" /usr/local/bin; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*; do
      [[ -f "$f" && -x "$f" && -r "$f" ]] || continue
      name=$(basename "$f")
      [[ "$name" != "$self" && -z "${seen[$name]:-}" ]] || continue
      top=$(head -c 4096 "$f" 2>/dev/null | tr -d '\0' | head -30)
      head=$(head -5 <<<"$top")
      desc=$(grep -m1 -a '^# help-commands:' <<<"$head" | sed 's/^# help-commands: *//')
      [[ -n "$desc" ]] || continue
      group=$(grep -m1 -a '^# help-commands-group:' <<<"$head" | sed 's/^# help-commands-group: *//; s/ *$//')
      [[ -n "$group" ]] || group=${mapped[$name]:-$default_group}
      spec=$(grep -a '^# help-commands-arg:' <<<"$top" | sed 's/^# help-commands-arg: *//' | tr -d '\t' | paste -sd "$sep")
      seen[$name]=1
      printf '%s\t%s\t%s\t%s\t%s\n' "$group" "$name" "$desc" "$f" "$spec"
    done
  done | sort -t $'\t' -k1,1 -k2,2
)

# The groups in use, once and in order: what a new command can pick from.
known_groups=()
for g in "${groups[@]}"; do
  [[ " ${known_groups[*]} " == *" $g "* ]] || known_groups+=("$g")
done

# Asks until the answer is not empty.
ask() {
  local prompt=$1 answer
  while :; do
    read -rep "$prompt" answer
    answer=$(sed 's/^ *//; s/ *$//' <<<"$answer")
    [[ -n "$answer" ]] && { printf '%s' "$answer"; return; }
    echo "$t_empty" >&2
  done
}

add_command() {
  local name group desc cmd answer i own="$HOME/.local/bin"

  while :; do
    name=$(ask "$t_name")
    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
      echo "$t_bad_name" >&2
    elif [[ -e "$own/$name" || -e "/usr/local/bin/$name" ]]; then
      # shellcheck disable=SC2059  # the format is ours
      printf "$t_taken\n" "$name" >&2
    else
      break
    fi
  done

  if (( ${#known_groups[@]} > 0 )); then
    echo "$t_groups"
    for i in "${!known_groups[@]}"; do
      printf '  %d) %s\n' $((i + 1)) "${known_groups[$i]}"
    done
  fi

  while :; do
    group=$(ask "$t_group")
    if [[ "$group" =~ ^[0-9]+$ ]] && (( group >= 1 && group <= ${#known_groups[@]} )); then
      group=${known_groups[$((group - 1))]}
      break
    fi
    # The same group with other capitals keeps its own spelling.
    for g in "${known_groups[@]}"; do
      [[ "${g,,}" == "${group,,}" ]] && { group=$g; break 2; }
    done
    # shellcheck disable=SC2059  # the format is ours
    read -rep "$(printf "$t_new_group" "$group")" answer
    [[ "$answer" =~ ^[nN] ]] || break
  done

  desc=$(ask "$t_desc")
  cmd=$(ask "$t_cmd")

  mkdir -p "$own"
  printf '#!/usr/bin/env bash\n# help-commands: %s\n# help-commands-group: %s\n\n%s\n' "$desc" "$group" "$cmd" >"$own/$name"
  chmod 755 "$own/$name"
  # shellcheck disable=SC2059  # the format is ours
  printf "$t_added\n" "$name" "$own" "$group"
}

if [[ "${1:-}" == "--add" ]]; then
  add_command
  exit 0
fi

if (( ${#names[@]} == 0 )); then
  echo "$t_none"
  exit 0
fi

print_list() {
  local i n=0 last=""
  for i in "${!names[@]}"; do
    if [[ "${groups[$i]}" != "$last" ]]; then
      [[ -n "$last" ]] && echo
      printf '\e[1;4m%s\e[0m\n' "${groups[$i]}"
      last=${groups[$i]}
    fi
    n=$((n + 1))
    printf '  \e[1m%2d) %-18s\e[0m %s\n' "$n" "${names[$i]}" "${descs[$i]}"
  done
}

if [[ "${1:-}" == "--list" || ! -t 0 || ! -t 1 ]]; then
  print_list
  exit 0
fi

pick=-1
if command -v whiptail >/dev/null 2>&1; then
  cols=$(tput cols 2>/dev/null || echo 100)
  lines=$(tput lines 2>/dev/null || echo 24)
  width=$(( cols > 20 ? cols - 4 : cols ))
  items=()
  last=""
  for i in "${!names[@]}"; do
    if [[ "${groups[$i]}" != "$last" ]]; then
      items+=("·" "── ${groups[$i]} ──")
      last=${groups[$i]}
    fi
    items+=("${names[$i]}" "${descs[$i]}")
  done
  items+=("·" "" "+" "$t_add_item")
  menu_h=$(( ${#items[@]} / 2 ))
  (( menu_h > lines - 8 )) && menu_h=$(( lines - 8 ))
  while :; do
    choice=$(whiptail --title "$t_title" --menu "$t_menu" \
      $(( menu_h + 8 )) "$width" "$menu_h" "${items[@]}" 3>&1 1>&2 2>&3) || exit 0
    [[ "$choice" != "·" ]] && break
  done
  if [[ "$choice" == "+" ]]; then
    add_command
    exit 0
  fi
  for i in "${!names[@]}"; do
    [[ "${names[$i]}" == "$choice" ]] && pick=$i && break
  done
else
  print_list
  read -rp $'\n'"$t_number" n
  [[ -n "$n" ]] || exit 0
  if [[ ! "$n" =~ ^[0-9]+$ ]] || (( n < 1 || n > ${#names[@]} )); then
    echo "$t_invalid $n" >&2
    exit 1
  fi
  pick=$((n - 1))
fi

(( pick >= 0 )) || exit 0

# Asks for each declared parameter, in order, and leaves the answers in `argv`: "<name>" is asked again while empty, "[name]"
# left empty is not passed, "name=a|b" starts with a and proposes b.
ask_params() {
  local line inside name required help values default prompt answer
  local re_required='^[[:space:]]*<([^<>]+)>[[:space:]]*(.*)$'
  local re_optional='^[[:space:]]*\[([^][]+)\][[:space:]]*(.*)$'
  local -a lines
  IFS="$sep" read -ra lines <<<"$1"
  argv=()

  for line in "${lines[@]}"; do
    if [[ "$line" =~ $re_required ]]; then
      required=1
    elif [[ "$line" =~ $re_optional ]]; then
      required=0
    else
      continue
    fi
    inside=${BASH_REMATCH[1]}
    help=${BASH_REMATCH[2]}
    name=$(sed 's/^ *//; s/ *$//' <<<"${inside%%=*}")
    [[ -n "$name" ]] || continue
    values=""
    default=""
    if [[ "$inside" == *=* ]]; then
      values=$(sed 's/ *| */|/g; s/^ *|*//; s/|* *$//; s/||*/|/g' <<<"${inside#*=}")
      default=${values%%|*}
    fi

    prompt=$name
    (( required )) || prompt+=", $t_optional"
    [[ "$values" == *"|"* ]] && prompt+=" ($values)"
    [[ -n "$help" ]] && prompt+=" — $help"
    prompt+=": "

    while :; do
      read -rep "$prompt" -i "$default" answer || { echo; exit 0; }
      answer=$(sed 's/^ *//; s/ *$//' <<<"$answer")
      if [[ -n "$answer" ]]; then
        argv+=("$answer")
        break
      fi
      (( required )) || break
      # shellcheck disable=SC2059  # the format is ours
      printf "$t_missing\n" "$name" >&2
    done
  done
}

if [[ -n "${specs[$pick]}" ]]; then
  ask_params "${specs[$pick]}"
  shown=""
  (( ${#argv[@]} > 0 )) && shown=$(printf ' %q' "${argv[@]}")
  echo "→ ${names[$pick]}$shown"
  # By its path: ~/.local/bin is not always in the PATH.
  exec "${paths[$pick]}" "${argv[@]}"
fi

# shellcheck disable=SC2059  # the format is ours
read -rep "$(printf "$t_args" "${names[$pick]}")" args
echo "→ ${names[$pick]} $args"
# shellcheck disable=SC2086  # the arguments split as they would in the terminal
exec "${paths[$pick]}" $args
